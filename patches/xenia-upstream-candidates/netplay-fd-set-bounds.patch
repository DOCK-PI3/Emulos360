Subject: [PATCH] [NET] Validate fd_count count

---
 src/xenia/kernel/xam/xam_net.cc | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/xenia/kernel/xam/xam_net.cc b/src/xenia/kernel/xam/xam_net.cc
index d95ea54dbb8..eab8a80a22b 100644
--- a/src/xenia/kernel/xam/xam_net.cc
+++ b/src/xenia/kernel/xam/xam_net.cc
@@ -2321,6 +2321,10 @@ struct host_set {
 };
 
 bool verify_x_fd_set(const x_fd_set* guest_set) {
+  if (!guest_set || guest_set->fd_count > X_FD_SETSIZE) {
+    return false;
+  }
+
   for (uint32_t i = 0; i < guest_set->fd_count; ++i) {
     auto socket_handle = static_cast<X_HANDLE>(guest_set->fd_array[i]);
     if (socket_handle == -1) {
