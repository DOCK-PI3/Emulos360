From 1b242658e535fbd12645e4d2c12693771075b738 Mon Sep 17 00:00:00 2001
From: Tim <peerloomllc@proton.me>
Date: Wed, 2 Sep 2026 23:14:13 -0500
Subject: [PATCH] [Vulkan] Lock the binding layout tables during parallel
 shader translation

TranslateShadersForStorage translates the stored shaders on several threads
at startup, and each translation registers its texture binding layout in
texture_binding_layouts_ and texture_binding_layout_map_, which the whole
cache shares. Nothing serialised that, so two threads could grow the vector
or rehash the map at the same time, and the process aborted in glibc's free
inside TranslateAnalyzedShader ("double free or corruption", "unaligned
tcache chunk") before the title started. layouts_mutex_ has been declared
for this since 46202dd27 and never taken; the D3D12 cache takes it around
the same block.
---
 src/xenia/gpu/vulkan/vulkan_pipeline_cache.cc | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/xenia/gpu/vulkan/vulkan_pipeline_cache.cc b/src/xenia/gpu/vulkan/vulkan_pipeline_cache.cc
index a1d1c37c781..005510e1646 100644
--- a/src/xenia/gpu/vulkan/vulkan_pipeline_cache.cc
+++ b/src/xenia/gpu/vulkan/vulkan_pipeline_cache.cc
@@ -959,6 +959,9 @@ bool VulkanPipelineCache::TranslateAnalyzedShader(
           texture_binding_count * sizeof(*texture_bindings.data());
       uint64_t texture_binding_layout_hash =
           XXH3_64bits(texture_bindings.data(), texture_binding_layout_bytes);
+      // The layout vector and map are shared by every thread translating
+      // shaders for the storage at startup.
+      std::lock_guard<std::mutex> layouts_lock(layouts_mutex_);
       auto found_range =
           texture_binding_layout_map_.equal_range(texture_binding_layout_hash);
       for (auto it = found_range.first; it != found_range.second; ++it) {
