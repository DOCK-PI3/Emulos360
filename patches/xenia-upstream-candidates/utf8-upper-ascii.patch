From 19c23eb1123f891d44f6548429758b612fe0ae7e Mon Sep 17 00:00:00 2001
From: Tim <peerloomllc@proton.me>
Date: Wed, 7 Oct 2026 11:04:35 -0500
Subject: [PATCH] [Base] Fix upper_ascii lowering instead of raising

upper_ascii(uint32_t) was a copy of lower_ascii. Add tests for both.
---
 src/xenia/base/testing/utf8_test.cc | 12 ++++++++++--
 src/xenia/base/utf8.cc              |  2 +-
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/src/xenia/base/testing/utf8_test.cc b/src/xenia/base/testing/utf8_test.cc
index 77e04dd37a6..f3ed666905b 100644
--- a/src/xenia/base/testing/utf8_test.cc
+++ b/src/xenia/base/testing/utf8_test.cc
@@ -220,8 +220,16 @@ TEST_CASE("UTF-8 Count", "[utf8]") {
   TEST_LANGUAGE_EXAMPLES(utf8::count, results);
 }
 
-// TODO(gibbed): lower_ascii
-// TODO(gibbed): upper_ascii
+TEST_CASE("UTF-8 Lower ASCII", "[utf8]") {
+  REQUIRE(utf8::lower_ascii("Hello, World 123") == "hello, world 123");
+  REQUIRE(utf8::lower_ascii("ÆBLE ÅB") == "Æble Åb");
+}
+
+TEST_CASE("UTF-8 Upper ASCII", "[utf8]") {
+  REQUIRE(utf8::upper_ascii("Hello, World 123") == "HELLO, WORLD 123");
+  REQUIRE(utf8::upper_ascii("HELLO") == "HELLO");
+  REQUIRE(utf8::upper_ascii("æble åb") == "æBLE åB");
+}
 // TODO(gibbed): hash_fnv1a
 // TODO(gibbed): hash_fnv1a_case
 
diff --git a/src/xenia/base/utf8.cc b/src/xenia/base/utf8.cc
index 9305f1f28a8..71256a321af 100644
--- a/src/xenia/base/utf8.cc
+++ b/src/xenia/base/utf8.cc
@@ -36,7 +36,7 @@ uint32_t lower_ascii(const uint32_t c) {
 }
 
 uint32_t upper_ascii(const uint32_t c) {
-  return c >= 'A' && c <= 'Z' ? c + 32 : c;
+  return c >= 'a' && c <= 'z' ? c - 32 : c;
 }
 
 bool equal_ascii_case(const uint32_t l, const uint32_t r) {
