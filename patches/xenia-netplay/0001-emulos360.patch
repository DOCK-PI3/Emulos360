@@ -0,0 +1,312 @@
+// Emulos360 extension: native profile IPC, reusing Xenia's Account encryption.
+#include "xenia/app/emulos_profile_bridge.h"
+#include <fstream>
+#include <charconv>
+#include <chrono>
+#include "third_party/tomlplusplus/toml.hpp"
+#include "xenia/base/cvar.h"
+#include "xenia/base/logging.h"
+#include "xenia/base/string.h"
+#include "xenia/emulator.h"
+#include "xenia/kernel/kernel_state.h"
+#include "xenia/kernel/title_id_utils.h"
+#include "xenia/kernel/xam/xam_state.h"
+#include "xenia/kernel/xam/xam_content_device.h"
+#include "xenia/config.h"
+#include "xenia/kernel/xam/emulos_avatar_manifest.h"
+#include "xenia/app/emulos_achievements.h"
+
+DECLARE_path(emulos_external_content_root);
+
+DEFINE_transient_string(emulos_profile_command, "", "Emulos360 IPC: profiles/content", "Emulos360");
+DEFINE_transient_string(emulos_profile_name, "", "New local profile gamertag", "Emulos360");
+DEFINE_transient_string(emulos_profile_xuid, "", "Existing local profile for Netplay activation", "Emulos360");
+DEFINE_transient_path(emulos_profile_output, "", "Emulos360 IPC result file", "Emulos360");
+DEFINE_transient_path(emulos_avatar_manifest_file, "", "Original 1000-byte avatar manifest to save", "Emulos360");
+DEFINE_transient_path(emulos_content_package_file, "", "Original profile/save package to install", "Emulos360");
+DEFINE_transient_string(emulos_game_title_id, "", "Expected game title ID for content installation", "Emulos360");
+DEFINE_transient_string(emulos_game_media_id, "", "Expected game media ID for title updates", "Emulos360");
+
+namespace xe::app::emulos {
+// Emulos360-only smoke check: real ContentManager routing in a disposable directory.
+static std::string CheckStorage(Emulator* emulator) {
+  namespace fs = std::filesystem;
+  using namespace kernel::xam;
+  if (!fs::exists(emulator->content_root() / ".emulos-storage-check")) return "Missing disposable-storage marker";
+  if (ListStorageDevices().size() != 2) return "Expected two writable devices";
+  auto manager = emulator->kernel_state()->content_manager();
+  constexpr uint64_t xuid = 0xE00000000000EE01;
+  constexpr uint32_t title = 0xEE000001;
+  for (uint32_t device : {1u, 3u}) {
+    XCONTENT_DATA_INTERNAL data{};
+    data.device_id = device; data.xuid = xuid; data.title_id = title;
+    data.content_type = XContentType::kSavedGame;
+    data.set_file_name("storage-probe"); data.set_display_name(u"Emulos360 storage probe");
+    if (manager->CreateContent("emulosprobe", xuid, data) != X_ERROR_SUCCESS) return "CreateContent failed";
+    auto package = manager->FindPackage(data);
+    if (!package) return "Device identity lost in mounted package";
+    auto expected = (device == 1 ? emulator->content_root() : cvars::emulos_external_content_root) /
+                    "E00000000000EE01/EE000001/00000001/storage-probe";
+    if (package->GetPackageHostPath() != expected) return "Wrong storage root";
+    { std::ofstream file(expected / "probe.txt"); file << device; }
+    if (manager->CloseContent("emulosprobe") != X_ERROR_SUCCESS) return "CloseContent failed";
+    const auto list = manager->ListContent(device, xuid, title, XContentType::kSavedGame, static_cast<XContentFlag>(0));
+    if (list.size() != 1 || list.front().device_id != device) return "Enumeration mixed device saves";
+    uint32_t license = 0;
+    if (manager->OpenContent("emulosprobe", xuid, data, license) != X_ERROR_SUCCESS) return "Reopen failed";
+    int stored = 0; { std::ifstream file(expected / "probe.txt"); file >> stored; }
+    if (stored != static_cast<int>(device)) return "Save contents crossed devices";
+    manager->CloseContent("emulosprobe");
+  }
+  auto external = cvars::emulos_external_content_root;
+  auto disconnected = external; disconnected += ".disconnected";
+  std::error_code ec; fs::rename(external, disconnected, ec);
+  if (ec) return "Unable to simulate disconnection";
+  const bool hidden = ListStorageDevices().size() == 1 && GetDummyDeviceInfo(3) == nullptr;
+  XCONTENT_DATA_INTERNAL absent{};
+  absent.device_id = 3; absent.xuid = xuid; absent.title_id = title;
+  absent.content_type = XContentType::kSavedGame; absent.set_file_name("disconnected-probe");
+  const auto result = manager->CreateContent("emulosprobe",xuid,absent);
+  fs::rename(disconnected,external,ec);
+  if (ec || !hidden || result != X_ERROR_DEVICE_NOT_CONNECTED) return "Disconnected device did not fail safely";
+  return {};
+}
+bool ProfileCommandRequested() { return !cvars::emulos_profile_command.empty(); }
+// Edit the mounted dashboard GPD without signing in, changing player slots,
+// touching achievements, or starting network/profile maintenance.
+static bool WriteAvatarSetting(Emulator* emulator,uint64_t xuid,const std::vector<uint8_t>& bytes) {
+  using namespace kernel::xam;
+  const auto path=fmt::format("User_{:016X}:\\{:08X}.gpd",xuid,kernel::kDashboardID);
+  auto vfs=emulator->kernel_state()->file_system();
+  vfs::File* file=nullptr;vfs::FileAction action;
+  // A newly created offline profile has only Account until its first login.
+  // Initialize its dashboard database without signing in. Never replace an
+  // existing unreadable or invalid database with an empty one.
+  GpdInfoProfile gpd;
+  std::vector<uint8_t> data;
+  size_t transferred=0;
+  if(vfs->ResolvePath(path)) {
+    if(vfs->OpenFile(nullptr,path,vfs::FileDisposition::kOpen,vfs::FileAccess::kGenericRead,false,true,&file,&action)!=X_STATUS_SUCCESS)return false;
+    const auto size=file->entry()->size();
+    if(size>64*1024*1024){file->Destroy();return false;}
+    data.resize(size);
+    const auto read=file->ReadSync(data,0,&transferred);file->Destroy();
+    if(read!=X_STATUS_SUCCESS||transferred!=data.size())return false;
+    gpd=GpdInfoProfile(data);
+    if(!gpd.IsValid())return false;
+  }
+  UserSetting setting(UserSettingId::XPROFILE_GAMERCARD_AVATAR_INFO_1,bytes);
+  gpd.UpsertSetting(&setting);data=gpd.Serialize();
+  if(vfs->OpenFile(nullptr,path,vfs::FileDisposition::kOverwriteIf,vfs::FileAccess::kGenericWrite,false,true,&file,&action)!=X_STATUS_SUCCESS)return false;
+  transferred=0;const auto written=file->WriteSync(data,0,&transferred);file->Destroy();
+  return written==X_STATUS_SUCCESS&&transferred==data.size();
+}
+void RunProfileCommand(Emulator* emulator, const std::string& setup_error) {
+  std::string error = setup_error;
+  toml::array profiles;
+  toml::array achievement_titles;
+  std::string avatar_manifest;
+  std::string installed_path;
+  if (error.empty()) {
+    auto manager = emulator->kernel_state()->xam_state()->profile_manager();
+    if (cvars::emulos_profile_command == "achievements") {
+      const auto& text = cvars::emulos_profile_xuid;
+      uint64_t xuid = 0;
+      const auto parsed = std::from_chars(text.data(), text.data() + text.size(), xuid, 16);
+      if (text.size() != 16 || parsed.ec != std::errc{} || parsed.ptr != text.data() + text.size() || !manager->GetAccount(xuid)) {
+        error = "Perfil inexistente o identificador invalido.";
+      } else if (!manager->MountProfile(xuid)) {
+        error = "No se pudo abrir el perfil para consultar sus logros.";
+      } else {
+        error = ReadAchievements(emulator, xuid, achievement_titles);
+        manager->DismountProfile(xuid);
+      }
+    } else if (cvars::emulos_profile_command == "create") {
+      const auto name = cvars::emulos_profile_name;
+      if (!kernel::xam::ProfileManager::IsGamertagValid(name)) {
+        error = "Gamertag invalido (1-15 caracteres, letras, numeros y espacios).";
+      } else {
+        for (const auto& [xuid, account] : *manager->GetAccounts()) {
+          if (account.GetGamertagString() == name) error = "Ya existe ese gamertag.";
+        }
+        if (error.empty() && !manager->CreateProfile(name, false)) {
+          error = "Xenia no pudo crear el perfil.";
+        }
+      }
+    } else if (cvars::emulos_profile_command == "import-content") {
+      namespace fs = std::filesystem;
+      using namespace kernel::xam;
+      const auto source = cvars::emulos_content_package_file;
+      std::error_code ec;
+      const auto status = fs::symlink_status(source, ec);
+      if (source.empty() || ec || !fs::is_regular_file(status) || fs::is_symlink(status)) {
+        error = "El paquete de perfil/partida no existe o no es un archivo normal.";
+      } else {
+        Emulator::ContentInstallEntry entry(source);
+        const auto inspected = emulator->ProcessContentPackageHeader(source, entry);
+        if (XFAILED(inspected)) {
+          error = "El contenedor Xbox 360 no es valido: " + entry.installation_error_message_;
+        } else if (entry.content_type_ != XContentType::kProfile &&
+                   entry.content_type_ != XContentType::kSavedGame) {
+          error = "Solo se permite importar un perfil o una partida guardada.";
+        } else {
+          const auto target = entry.data_installation_path_ / entry.filename_;
+          if (fs::exists(target) || fs::exists(entry.header_installation_path_)) {
+            error = "El perfil o la partida ya existe; no se ha sobrescrito.";
+          } else {
+            const auto result = emulator->InstallContentPackage(source, entry);
+            if (XFAILED(result)) {
+              error = "No se pudo instalar el contenedor: " + entry.installation_error_message_;
+            } else {
+              installed_path = xe::path_to_utf8(target);
+            }
+          }
+        }
+      }
+    } else if (cvars::emulos_profile_command == "install-game-content") {
+      namespace fs = std::filesystem;
+      using namespace kernel::xam;
+      const auto source = cvars::emulos_content_package_file;
+      std::error_code file_error;
+      const auto status = fs::symlink_status(source, file_error);
+      const auto parse_id = [](const std::string& text, uint32_t& value) {
+        const auto parsed = std::from_chars(text.data(), text.data() + text.size(), value, 16);
+        return text.size() == 8 && parsed.ec == std::errc{} && parsed.ptr == text.data() + text.size();
+      };
+      uint32_t expected_title = 0, expected_media = 0;
+      if (source.empty() || file_error || !fs::is_regular_file(status) || fs::is_symlink(status)) {
+        error = "El paquete no existe o no es un archivo normal.";
+      } else if (!parse_id(cvars::emulos_game_title_id, expected_title) || !expected_title ||
+                 (!cvars::emulos_game_media_id.empty() &&
+                  !parse_id(cvars::emulos_game_media_id, expected_media))) {
+        error = "Identificador de juego o medio invalido.";
+      } else {
+        Emulator::ContentInstallEntry entry(source);
+        const auto inspected = emulator->ProcessContentPackageHeader(source, entry);
+        auto package = emulator->kernel_state()->content_manager()->OpenPackage(source);
+        const auto header = package ? package->GetContainerHeader() : nullptr;
+        if (XFAILED(inspected) || !header) {
+          error = "El contenedor Xbox 360 no es valido: " + entry.installation_error_message_;
+        } else {
+          const auto type = entry.content_type_;
+          const auto title = header->content_metadata.execution_info.title_id.get();
+          const auto media = header->content_metadata.execution_info.media_id.get();
+          const auto profile = header->content_metadata.profile_id.get();
+          if (type != XContentType::kMarketplaceContent && type != XContentType::kInstaller)
+            error = "Solo se admiten DLC y actualizaciones de titulo.";
+          else if (title != expected_title)
+            error = "El paquete pertenece a otro juego.";
+          else if (type == XContentType::kInstaller && expected_media && media && media != expected_media)
+            error = "La actualizacion pertenece a otra edicion del juego (Media ID diferente).";
+          else if (profile != 0)
+            error = "El contenido esta ligado a otro perfil; no se ha instalado.";
+          else if (fs::exists(entry.data_installation_path_ / entry.filename_) ||
+                   fs::exists(entry.header_installation_path_))
+            error = "El contenido ya existe; no se ha sobrescrito.";
+          else {
+            const auto installed = emulator->InstallContentPackage(source, entry);
+            if (XFAILED(installed)) {
+              std::error_code cleanup_error;
+              fs::remove_all(entry.data_installation_path_ / entry.filename_, cleanup_error);
+              fs::remove(entry.header_installation_path_, cleanup_error);
+              error = "No se pudo instalar el contenido: " + entry.installation_error_message_;
+            } else
+              installed_path = xe::path_to_utf8(entry.data_installation_path_ / entry.filename_);
+          }
+        }
+      }
+    } else if (cvars::emulos_profile_command == "enable-netplay") {
+      const auto& text = cvars::emulos_profile_xuid;
+      uint64_t xuid = 0;
+      auto parsed = std::from_chars(text.data(), text.data() + text.size(), xuid, 16);
+      if (text.size() != 16 || parsed.ec != std::errc{} ||
+          parsed.ptr != text.data() + text.size() || !manager->GetAccount(xuid)) {
+        error = "Perfil inexistente o identificador invalido.";
+      } else if (!manager->GetAccount(xuid)->IsLiveEnabled()) {
+        // Keep the local XUID/save paths. Preserve Account and dashboard GPDs
+        // before using upstream's supported profile conversion.
+        namespace fs = std::filesystem;
+        const auto source = manager->GetProfileContentPath(xuid, kernel::kDashboardID);
+        const auto stamp = std::chrono::system_clock::now().time_since_epoch().count();
+        const auto backup = emulator->content_root().parent_path() / "profile-backups" /
+                            fmt::format("{}-before-netplay-{}", text, stamp);
+        std::error_code ec;
+        fs::create_directories(backup.parent_path(), ec);
+        if (!ec) fs::copy(source, backup, fs::copy_options::recursive, ec);
+        if (ec) error = "No se pudo respaldar el perfil: " + ec.message();
+        else if (!manager->ConvertToXboxLiveEnabledProfile(xuid))
+          error = "No se pudo habilitar Netplay. Se conserva la copia del perfil.";
+      }
+    } else if (cvars::emulos_profile_command == "avatar-read" || cvars::emulos_profile_command == "avatar-write") {
+      using namespace kernel::xam;
+      const auto& text = cvars::emulos_profile_xuid;
+      uint64_t xuid = 0;
+      const auto parsed = std::from_chars(text.data(), text.data() + text.size(), xuid, 16);
+      if (text.size() != 16 || parsed.ec != std::errc{} || parsed.ptr != text.data()+text.size() || !manager->GetAccount(xuid)) {
+        error = "Perfil inexistente o identificador invalido.";
+      } else if (!manager->MountProfile(xuid)) {
+        error = "No se pudo montar el perfil para acceder al avatar.";
+      } else {
+        // Read through a temporary profile without signing in or changing GPDs.
+        auto tracker = emulator->kernel_state()->xam_state()->user_tracker();
+        const auto setting_id = UserSettingId::XPROFILE_GAMERCARD_AVATAR_INFO_1;
+        if (cvars::emulos_profile_command == "avatar-write") {
+          std::ifstream input(cvars::emulos_avatar_manifest_file, std::ios::binary);
+          std::vector<uint8_t> bytes(1001);
+          input.read(reinterpret_cast<char*>(bytes.data()), bytes.size());
+          bytes.resize(static_cast<size_t>(input.gcount()));
+          if (bytes.size()!=1000 || !kernel::xam::emulos::AvatarBodyType(bytes)) {
+            error = "Manifiesto de avatar invalido.";
+          } else {
+            namespace fs = std::filesystem;
+            const auto stamp = std::chrono::system_clock::now().time_since_epoch().count();
+            const auto backup = emulator->content_root().parent_path()/"profile-backups"/fmt::format("{}-before-avatar-{}",text,stamp);
+            std::error_code ec; fs::create_directories(backup.parent_path(),ec);
+            if(!ec)fs::copy(manager->GetProfileContentPath(xuid,kernel::kDashboardID),backup,fs::copy_options::recursive,ec);
+            if(ec)error="No se pudo respaldar el perfil: "+ec.message();
+            else {
+              {
+                if(!WriteAvatarSetting(emulator,xuid,bytes))error="No se pudo escribir el avatar en el perfil.";
+                // Confirm the persisted GPD, not just the in-memory setting.
+                // Remount to discard VFS entries caching the old file length.
+                manager->DismountProfile(xuid);
+                if(!manager->MountProfile(xuid) && error.empty())error="No se pudo reabrir el perfil guardado.";
+                UserProfile verify(xuid,manager->GetAccount(xuid));
+                const auto stored=tracker->GetSetting(&verify,kernel::kDashboardID,static_cast<uint32_t>(setting_id));
+                if(error.empty() && (!stored||stored->get_extended_data().size()!=bytes.size()||!std::equal(bytes.begin(),bytes.end(),stored->get_extended_data().begin())))error="El avatar no se pudo verificar en el perfil guardado.";
+              }
+            }
+          }
+        }
+        UserProfile persisted(xuid,manager->GetAccount(xuid));
+        const auto setting=tracker->GetSetting(&persisted,kernel::kDashboardID,static_cast<uint32_t>(setting_id));
+        if(setting && setting->get_type()==X_USER_DATA_TYPE::BINARY && setting->get_extended_data().size()==1000)
+          for(auto byte:setting->get_extended_data())avatar_manifest+=fmt::format("{:02x}",byte);
+        manager->DismountProfile(xuid);
+      }
+    } else if (cvars::emulos_profile_command == "storage-check") {
+      error = CheckStorage(emulator);
+    } else if (cvars::emulos_profile_command == "catalog") {
+      config::SaveConfig();
+    } else if (cvars::emulos_profile_command != "list") {
+      error = "Comando de perfiles desconocido.";
+    }
+    manager->ReloadProfiles();
+    for (const auto& [xuid, account] : *manager->GetAccounts()) {
+      profiles.push_back(toml::table{{"xuid", fmt::format("{:016X}", xuid)},
+                                   {"gamertag", account.GetGamertagString()},
+                                   {"netplay", account.IsLiveEnabled()}});
+    }
+  }
+  toml::table result{{"version", 1}, {"ok", error.empty()}, {"error", error},
+                     {"profiles", std::move(profiles)}, {"avatar_manifest",avatar_manifest},
+                     {"installed_path",installed_path},
+                     {"achievementXuid", cvars::emulos_profile_xuid},
+                     {"achievementTitles", std::move(achievement_titles)}};
+  // The caller waits for process exit before reading this unique result file.
+  std::ofstream output(cvars::emulos_profile_output, std::ios::binary | std::ios::trunc);
+  output << toml::toml_formatter{result};
+  output.close();
+  if (!output) XELOGE("Emulos360: cannot write profile command result");
+}
+}
