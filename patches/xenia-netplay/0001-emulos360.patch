+inline std::optional<AvatarAssetCatalog> AvatarAssetCatalog::Parse(std::vector<uint8_t> bytes) {
+  constexpr AvatarAssetId v1 = {0x8a,0x76,0x2d,0xf4,0xc0,0x67,0x4b,0x66,0xb4,0xee,0x56,0x46,0x6b,0x1b,0x82,0x80};
+  constexpr AvatarAssetId v2 = {0x58,0x0a,0x07,0xd6,0x4b,0xcd,0x40,0xbe,0xbf,0x37,0x25,0x4b,0xe8,0x26,0xfb,0x0b};
+  if (bytes.size() < 40 || bytes.size() > 64 * 1024 * 1024) return {};
+  AvatarCursor header(bytes);
+  const auto signature = header.Take(16);
+  const auto generation = header.Take(8);
+  const auto version = header.Integer(4, true);
+  if ((version != 1 || !std::equal(signature.begin(), signature.end(), v1.begin())) &&
+      (version != 2 || !std::equal(signature.begin(), signature.end(), v2.begin()))) return {};
+  const auto count = header.Integer(4, true);
+  if (header.Integer(4, true) != version || header.Integer(4, true) != 0) return {};
+  uint32_t languages = 13;
+  if (version == 2) {
+    languages = header.Integer(4, true);
+    if (languages != 18 || header.Integer(4, true) != 0) return {};
+  }
+  const size_t stride = 196 + languages * 4;
+  if (!header.ok() || count > 65536 || count > header.remaining() / stride) return {};
+  const size_t names_begin = header.offset() + count * stride;
+  AvatarAssetCatalog catalog;
+  catalog.version_ = version;
+  for (uint32_t index = 0; index < count; ++index) {
+    const auto data = header.Take(stride);
+    AvatarCursor record(data);
+    AvatarAssetRecord asset;
+    asset.component_mask = record.Integer(4, true);
+    asset.body_mask = static_cast<uint8_t>(record.Integer(1));
+    std::copy_n(data.begin() + 156, 16, asset.dependencies[0].begin());
+    std::copy_n(data.begin() + 172, 16, asset.dependencies[1].begin());
+    record.Take(183);
+    std::vector<uint32_t> names;
+    for (uint32_t language = 0; language < languages; ++language)
+      names.push_back(record.Integer(4, true));
+    asset.offset = record.Integer(4, true);
+    asset.size = record.Integer(4, true);
+    // Deleted/unused directory entries must not be exposed as assets.
+    if (!asset.component_mask && !asset.size) continue;
+    if (!record.ok() || !asset.body_mask || asset.body_mask > 3 || !asset.size ||
+        asset.offset < names_begin || asset.offset > bytes.size() || asset.size > bytes.size() - asset.offset) return {};
+    std::copy_n(data.begin(), 4, asset.id.begin());
+    asset.id[4] = static_cast<uint8_t>(index >> 8);
+    asset.id[5] = static_cast<uint8_t>(index);
+    asset.id[7] = asset.body_mask;
+    std::copy(generation.begin(), generation.end(), asset.id.begin() + 8);
+    // Asset-pack IDs encode the built-in resource class in the high two bits.
+    asset.id[8] |= 0xc0;
+    for (const auto offset : names) {
+      if (offset < names_begin || offset >= bytes.size() || offset % 2) return {};
+      AvatarCursor name(AvatarBytes(bytes).subspan(offset));
+      std::u16string value;
+      bool terminated = false;
+      for (size_t n = 0; n < 1024 && name.remaining() >= 2; ++n) {
+        const auto c = static_cast<char16_t>(name.Integer(2, true));
+        if (!c) { terminated = true; break; }
+        value.push_back(c);
+      }
+      if (!terminated) return {};
+      asset.names.push_back(std::move(value));
+    }
+    catalog.records_.push_back(std::move(asset));
+  }
+  catalog.bytes_ = std::move(bytes);
+  return catalog;
+}
