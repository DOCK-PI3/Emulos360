diff --git a/CMakeLists.txt b/CMakeLists.txt
index f0ecb04..88dc265 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -81,6 +81,13 @@ file(MAKE_DIRECTORY "${PROJECT_SOURCE_DIR}/scratch")
 
 # Python for shader compilation scripts
 find_package(Python3 REQUIRED COMPONENTS Interpreter)
+execute_process(
+  COMMAND ${Python3_EXECUTABLE} -c
+    "import runpy, sys; runpy.run_path('xenia-build.py')['generate_version_h'](sys.argv[1])"
+    "${CMAKE_BINARY_DIR}"
+  WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
+  COMMAND_ERROR_IS_FATAL ANY
+)
 
 # Include helpers
 include(cmake/XeniaHelpers.cmake)
