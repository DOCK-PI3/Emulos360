+inline std::optional<AvatarModelTexture> AvatarModelTexture::Parse(AvatarCursor& cursor) {
+  AvatarModelTexture texture;
+  uint32_t pitch, rows;
+  {
+    AvatarBits bits(cursor);
+    texture.format = bits.Read(32); texture.width = bits.Read(32); texture.height = bits.Read(32);
+    texture.tiled_size = bits.Read(32); texture.layer_size = bits.Read(32); texture.layers = bits.Read(32);
+    texture.empty = bits.Read(1) != 0; texture.flag = bits.Read(1) != 0;
+    pitch = bits.Read(32); rows = bits.Read(32);
+    if (!bits.ok() || !texture.width || texture.width > 1024 || !texture.height || texture.height > 1024 || !texture.layers || texture.layers > 16) return {};
+  }
+  if (!texture.empty) {
+    const auto format = texture.format & 63;
+    if (format < 18 || format > 20 || pitch != ((texture.width + 3) / 4) * (format == 18 ? 8 : 16) || rows != (texture.height + 3) / 4) return {};
+    const auto data = cursor.Take(size_t(pitch) * rows * texture.layers);
+    if (!cursor.ok()) return {};
+    texture.pixels.assign(data.begin(), data.end());
+  }
+  return texture;
+}
