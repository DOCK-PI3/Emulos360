+// Only immutable host resources are cached, never guest allocations or
+// callbacks. Initialization/shutdown replaces the cache; in-flight work owns
+// a shared reference. The application runs one emulator instance per process.
+std::mutex avatar_resources_mutex;
+std::shared_ptr<const emulos::AvatarGuestResources> avatar_resources;
+void SetAvatarResources(std::shared_ptr<const emulos::AvatarGuestResources> value) {
+  std::lock_guard lock(avatar_resources_mutex);
+  avatar_resources = std::move(value);
+}
+std::shared_ptr<const emulos::AvatarGuestResources> GetAvatarResources() {
+  std::lock_guard lock(avatar_resources_mutex);
+  return avatar_resources && avatar_resources->owner == kernel_state() ? avatar_resources : nullptr;
+}
+std::vector<uint8_t> ReadAvatarResource(const std::filesystem::path& path, size_t limit) {
+  std::ifstream stream(path, std::ios::binary | std::ios::ate);
+  if (!stream) return {};
+  const auto size = stream.tellg();
+  if (size <= 0 || uint64_t(size) > limit) return {};
+  std::vector<uint8_t> data(static_cast<size_t>(size));
+  stream.seekg(0);
+  if (!stream.read(reinterpret_cast<char*>(data.data()), size)) return {};
+  return data;
+}
+bool AvatarGuestRange(uint32_t address, size_t size, bool writable) {
+  if (!address || !size || uint64_t(address) + size > uint64_t(UINT32_MAX) + 1) return false;
+  auto* heap = kernel_state()->memory()->LookupHeap(address);
+  if (!heap) return false;
+  const auto access = heap->QueryRangeAccess(address, address + static_cast<uint32_t>(size - 1));
+  return writable ? access == xe::memory::PageAccess::kReadWrite : access != xe::memory::PageAccess::kNoAccess;
+}
+}
 
