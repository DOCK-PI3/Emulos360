+struct AvatarIntegerPacking {
+  uint32_t minimum = 0, count = 0;
+  bool ReadHeader(AvatarBits& bits, uint32_t width = 32) {
+    minimum = bits.Read(width); count = bits.Read(width);
+    return count <= width && bits.ok();
+  }
+  uint32_t Read(AvatarBits& bits) const { return minimum + bits.Read(count); }
+};
+
+struct AvatarPositionPacking {
+  float radius = 0;
+  std::array<float, 3> minimum{};
+  std::array<uint32_t, 3> counts{};
+  bool ReadHeader(AvatarBits& bits) {
+    radius = bits.Float();
+    for (auto& value : minimum) value = bits.Float();
+    for (auto& count : counts) count = bits.Read(6);
+    return bits.ok() && std::isfinite(radius) && radius >= 0 &&
+      std::all_of(minimum.begin(), minimum.end(), [](float f){return std::isfinite(f);}) &&
+      std::all_of(counts.begin(), counts.end(), [](uint32_t n){return n <= 32;});
+  }
+  std::array<float, 3> Read(AvatarBits& bits) const {
+    const auto x = bits.Read(counts[0]), y = bits.Read(counts[1]), z = bits.Read(counts[2]);
+    const float dx = radius * 2.0f, dy = radius * 1.632993161855452f, dz = radius * 1.732050807568877f;
+    std::array<float, 3> value = {minimum[0] + dx * static_cast<float>(x), minimum[1] + dy * static_cast<float>(y), minimum[2] + dz * static_cast<float>(z)};
+    if (y & 1) value[2] += 0.5773502691896258f * dz;
+    if ((y & 1) != (z & 1)) value[0] += 0.5f * dx;
+    return value;
+  }
+};
