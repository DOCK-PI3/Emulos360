+struct AvatarAssetRecord {
+  AvatarAssetId id{};
+  std::array<AvatarAssetId, 2> dependencies{};
+  uint32_t component_mask = 0;
+  uint8_t body_mask = 0;
+  uint32_t offset = 0, size = 0;
+  std::vector<std::u16string> names;
+};
