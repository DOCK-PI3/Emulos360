diff --git a/src/xenia/app/emulos_achievements.h b/src/xenia/app/emulos_achievements.h
new file mode 100644
index 0000000..0ac70ed
--- /dev/null
+++ b/src/xenia/app/emulos_achievements.h
@@ -0,0 +1,112 @@
+// Emulos360: read-only achievement snapshots using the engine's GPD readers.
+#pragma once
+#include "xenia/kernel/xam/xdbf/gpd_info_profile.h"
+#include "xenia/kernel/xam/xdbf/gpd_info_title.h"
+
+namespace xe::app::emulos {
+
+// The upstream reader expects valid entry ranges and terminated UTF-16 strings.
+// Validate those before passing a persisted database to it.
+inline bool ValidateAchievementGpd(const std::vector<uint8_t>& bytes) {
+  using namespace kernel::xam;
+  if (bytes.size() < sizeof(XdbfHeader)) return false;
+  XdbfHeader h;
+  std::memcpy(&h, bytes.data(), sizeof(h));
+  const uint64_t start = sizeof(h) + uint64_t(h.entry_count) * sizeof(XdbfEntry) +
+                         uint64_t(h.free_count) * sizeof(XdbfFileLoc);
+  if (h.magic != kXdbfSignatureXdbf || h.entry_used > h.entry_count ||
+      !h.free_used || h.free_used > h.free_count || start > bytes.size()) return false;
+  for (uint32_t i = 0; i < h.entry_used; ++i) {
+    XdbfEntry entry;
+    std::memcpy(&entry, bytes.data() + sizeof(h) + i * sizeof(entry), sizeof(entry));
+    if (uint64_t(entry.offset) + entry.size > bytes.size() - start) return false;
+    if (entry.id == 0x100000000 || entry.id == 0x200000000) continue;
+    size_t offset = 0;
+    int strings = 0;
+    if (entry.section == uint16_t(GpdSection::kTitle)) {
+      offset = sizeof(X_XDBF_GPD_TITLE_PLAYED); strings = 1;
+    } else if (entry.section == uint16_t(GpdSection::kAchievement)) {
+      offset = sizeof(X_XDBF_GPD_ACHIEVEMENT); strings = 3;
+    }
+    if (!strings) continue;
+    if (offset > entry.size) return false;
+    const auto* data = bytes.data() + start + entry.offset;
+    for (; offset + 1 < entry.size && strings; offset += 2)
+      if (data[offset] == 0 && data[offset + 1] == 0) --strings;
+    if (strings) return false;
+  }
+  return true;
+}
+
+inline bool ReadAchievementGpd(Emulator* emulator, uint64_t xuid, uint32_t title,
+                               std::vector<uint8_t>& bytes, bool& missing) {
+  bytes.clear();
+  auto* fs = emulator->kernel_state()->file_system();
+  const auto path = fmt::format("User_{:016X}:\\{:08X}.gpd", xuid, title);
+  missing = !fs->ResolvePath(path);
+  if (missing) return false;
+  vfs::File* raw = nullptr;
+  vfs::FileAction action;
+  if (fs->OpenFile(nullptr, path, vfs::FileDisposition::kOpen,
+                   vfs::FileAccess::kGenericRead, false, true, &raw, &action) != X_STATUS_SUCCESS) return false;
+  const auto destroy = [](vfs::File* file) { file->Destroy(); };
+  const std::unique_ptr<vfs::File, decltype(destroy)> file(raw, destroy);
+  if (file->entry()->size() > 64 * 1024 * 1024) return false;
+  bytes.resize(file->entry()->size());
+  size_t read = 0;
+  return file->ReadSync(bytes, 0, &read) == X_STATUS_SUCCESS &&
+         read == bytes.size() && ValidateAchievementGpd(bytes);
+}
+
+inline std::string ReadAchievements(Emulator* emulator, uint64_t xuid,
+                                     toml::array& titles) {
+  using namespace kernel::xam;
+  std::vector<uint8_t> bytes;
+  bool missing = false;
+  if (!ReadAchievementGpd(emulator, xuid, kernel::kDashboardID, bytes, missing))
+    return missing ? "" : "No se pudo leer el historial de logros del perfil.";
+  GpdInfoProfile dashboard(bytes);
+  size_t icon_budget = 8 * 1024 * 1024;
+  for (const auto* title : dashboard.GetTitlesInfo()) {
+    if (!title->include_in_enumerator()) continue;
+    toml::array achievements;
+    const bool available = ReadAchievementGpd(emulator, xuid, title->title_id, bytes, missing);
+    if (available) {
+      GpdInfoTitle gpd(title->title_id, bytes);
+      for (auto id : gpd.GetAchievementsIds()) {
+        const auto* entry = gpd.GetAchievementEntry(id);
+        if (!entry) continue;
+        Achievement achievement(entry);
+        int64_t unlocked_at = 0;
+        if (achievement.IsUnlocked() && achievement.unlock_time.is_valid())
+          unlocked_at = std::chrono::duration_cast<std::chrono::seconds>(
+              chrono::WinSystemClock::to_sys(achievement.unlock_time.to_time_point()).time_since_epoch()).count();
+        std::string icon;
+        const auto image = gpd.GetImage(achievement.image_id);
+        if (image.size() <= 256 * 1024 && image.size() <= icon_budget) {
+          icon.reserve(image.size() * 2);
+          constexpr char hex[] = "0123456789abcdef";
+          for (auto byte : image) { icon += hex[byte >> 4]; icon += hex[byte & 15]; }
+          icon_budget -= image.size();
+        }
+        achievements.push_back(toml::table{
+            {"id", int64_t(id)}, {"name", xe::to_utf8(gpd.GetAchievementTitle(id))},
+            {"description", xe::to_utf8(achievement.IsUnlocked() ? gpd.GetAchievementDescription(id)
+                                                                  : gpd.GetAchievementUnachievedDescription(id))},
+            {"points", int64_t(achievement.gamerscore)}, {"unlocked", achievement.IsUnlocked()},
+            {"secret", !(achievement.flags & uint32_t(AchievementFlags::kShowUnachieved))},
+            {"unlockedAt", unlocked_at}, {"icon", icon}});
+      }
+    }
+    titles.push_back(toml::table{
+        {"titleId", fmt::format("{:08X}", uint32_t(title->title_id))},
+        {"title", xe::to_utf8(dashboard.GetTitleName(title->title_id))},
+        {"total", int64_t(uint32_t(title->achievements_count))},
+        {"unlocked", int64_t(uint32_t(title->achievements_unlocked))},
+        {"points", int64_t(uint32_t(title->gamerscore_earned))},
+        {"totalPoints", int64_t(uint32_t(title->gamerscore_total))},
+        {"detailsAvailable", available}, {"achievements", std::move(achievements)}});
+  }
+  return {};
+}
+}  // namespace xe::app::emulos
