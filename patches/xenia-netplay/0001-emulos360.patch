+class AvatarAssetCatalog {
+ public:
+  // Owns the archive; records and returned spans are valid until destruction.
+  static std::optional<AvatarAssetCatalog> Parse(std::vector<uint8_t> bytes);
+  const std::vector<AvatarAssetRecord>& records() const { return records_; }
+  uint32_t version() const { return version_; }
+  AvatarBytes Find(const AvatarAssetId& id) const {
+    for (const auto& record : records_)
+      if (record.id == id) return AvatarBytes(bytes_).subspan(record.offset, record.size);
+    return {};
+  }
+ private:
+  std::vector<uint8_t> bytes_;
+  std::vector<AvatarAssetRecord> records_;
+  uint32_t version_ = 0;
+};
