+// Each model frame is an independent LZX stream with a 32 KiB window.
+// The injected decoder permits native Xenia LZX and isolated format validation.
+template <typename Decompress>
+std::optional<std::vector<uint8_t>> DecodeAvatarModelFrames(AvatarBytes bytes, Decompress decompress) {
+  constexpr size_t max_size = 16 * 1024 * 1024;
+  AvatarCursor cursor(bytes);
+  std::vector<uint8_t> result;
+  while (cursor.remaining()) {
+    if (cursor.remaining() < 12) return {};
+    const auto compressed_size = cursor.Integer(4);
+    const auto offset = cursor.Integer(4);
+    const auto size = cursor.Integer(4);
+    if (!compressed_size || compressed_size > 40000 || !size || size > 32768 ||
+        offset < result.size() || offset > max_size || size > max_size - offset) return {};
+    const auto frame = cursor.Take(compressed_size);
+    if (!cursor.ok()) return {};
+    result.resize(offset + size);
+    if (!decompress(frame, std::span<uint8_t>(result).subspan(offset, size))) return {};
+  }
+  if (result.empty()) return {};
+  return result;
+}
