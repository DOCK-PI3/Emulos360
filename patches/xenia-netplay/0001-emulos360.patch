@@ -0,0 +1,64 @@
+// Emulos360: bounded decoding of the original packed avatar pose streams.
+#ifndef XENIA_KERNEL_XAM_EMULOS_AVATAR_ANIMATION_H_
+#define XENIA_KERNEL_XAM_EMULOS_AVATAR_ANIMATION_H_
+#include "xenia/kernel/xam/emulos_avatar_assets.h"
+#include <cstring>
+namespace xe::kernel::xam::emulos {
+struct AvatarPose {
+  std::array<float,3> position{}, scale{1,1,1};
+  std::array<float,4> rotation{0,0,0,1};
+};
+struct AvatarJoint { int32_t parent=-1; AvatarPose bind,local; };
+struct AvatarSkeleton {
+  std::vector<AvatarJoint> joints;
+  static std::optional<AvatarSkeleton> Parse(AvatarBytes bytes) {
+    if(bytes.size()<12||std::memcmp(bytes.data(),"EMUSKEL1",8))return {};
+    AvatarCursor cursor(bytes.subspan(8));const auto count=cursor.Integer(4);
+    if(!count||count>72||cursor.remaining()!=count*72)return {};
+    AvatarSkeleton rig;rig.joints.resize(count);
+    for(uint32_t i=0;i<count;++i){
+      auto& joint=rig.joints[i];joint.parent=static_cast<int32_t>(cursor.Integer(4));
+      if((i==0&&joint.parent!=-1)||(i>0&&(joint.parent<0||joint.parent>=int32_t(i))))return {};
+      auto read=[&](auto& values){for(auto& v:values){v=std::bit_cast<float>(cursor.Integer(4));if(!std::isfinite(v))return false;}return true;};
+      if(!read(joint.bind.position)||!read(joint.bind.rotation)||!read(joint.local.position)||!read(joint.local.rotation)||!read(joint.local.scale))return {};
+    }
+    return rig;
+  }
+};
+struct AvatarAnimation {
