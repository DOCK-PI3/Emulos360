+// Readers never dereference unaligned integers and never advance beyond input.
+class AvatarCursor {
+ public:
+  explicit AvatarCursor(AvatarBytes bytes) : bytes_(bytes) {}
+  AvatarBytes Take(size_t size) {
+    if (!ok_ || size > bytes_.size() - offset_) {
+      ok_ = false;
+      return {};
+    }
+    const auto result = bytes_.subspan(offset_, size);
+    offset_ += size;
+    return result;
+  }
+  uint32_t Integer(size_t size, bool big_endian = false) {
+    if (size > 4) { ok_ = false; return 0; }
+    const auto bytes = Take(size);
+    uint32_t value = 0;
+    for (size_t i = 0; i < bytes.size(); ++i)
+      value |= uint32_t(bytes[i]) << (8 * (big_endian ? size - 1 - i : i));
+    return value;
+  }
+  bool ok() const { return ok_; }
+  size_t offset() const { return offset_; }
+  size_t remaining() const { return bytes_.size() - offset_; }
+ private:
+  AvatarBytes bytes_;
+  size_t offset_ = 0;
+  bool ok_ = true;
+};
+
+class AvatarBits {
+ public:
+  explicit AvatarBits(AvatarCursor& cursor) : cursor_(cursor) {}
+  uint32_t Read(uint32_t count) {
+    if (count > 32) { ok_ = false; return 0; }
+    uint32_t result = 0;
+    for (uint32_t shift = 0; shift < count;) {
+      if (!available_) { byte_ = cursor_.Integer(1); available_ = 8; }
+      const auto n = std::min(count - shift, available_);
+      result |= (byte_ & ((1u << n) - 1)) << shift;
+      byte_ >>= n;
+      available_ -= n;
+      shift += n;
+    }
+    return result;
+  }
+  float Float() { return std::bit_cast<float>(Read(32)); }
+  bool ok() const { return ok_ && cursor_.ok(); }
+ private:
+  AvatarCursor& cursor_;
+  uint32_t byte_ = 0, available_ = 0;
+  bool ok_ = true;
+};
