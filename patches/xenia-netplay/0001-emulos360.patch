+
+std::vector<IP_ADAPTER_ADDRESSES>
+NetworkAdapterManager::DiscoverNetworkAdapters() {
+  ifaddrs* raw = nullptr;
+  if (getifaddrs(&raw) != 0) {
+    return {};
+  }
+  std::unique_ptr<ifaddrs, decltype(&freeifaddrs)> entries(raw, freeifaddrs);
+  std::vector<IP_ADAPTER_ADDRESSES> adapters;
+  for (auto* entry = entries.get(); entry; entry = entry->ifa_next) {
+    if (!entry->ifa_addr || entry->ifa_addr->sa_family != AF_INET ||
+        !(entry->ifa_flags & IFF_UP) || (entry->ifa_flags & IFF_LOOPBACK)) {
+      continue;
+    }
+    const std::string name(entry->ifa_name);
+    if (std::any_of(adapters.cbegin(), adapters.cend(),
+                    [&name](const auto& adapter) {
+                      return adapter.AdapterName == name;
+                    })) {
+      continue;
+    }
+    IP_ADAPTER_ADDRESSES adapter;
+    adapter.AdapterName = name;
+    adapter.IfIndex = if_nametoindex(entry->ifa_name);
+    adapter.Address = *reinterpret_cast<sockaddr_in*>(entry->ifa_addr);
+    adapters.push_back(std::move(adapter));
+  }
+  for (auto* entry = entries.get(); entry; entry = entry->ifa_next) {
+    if (!entry->ifa_addr || entry->ifa_addr->sa_family != AF_PACKET) {
+      continue;
+    }
+    const auto* packet = reinterpret_cast<sockaddr_ll*>(entry->ifa_addr);
+    if (packet->sll_halen < MacAddress::MacAddressSize) {
+      continue;
+    }
+    for (auto& adapter : adapters) {
+      if (adapter.AdapterName == entry->ifa_name) {
+        std::copy_n(packet->sll_addr, MacAddress::MacAddressSize,
+                    adapter.PhysicalAddress.begin());
+      }
+    }
+  }
+  return adapters;
+}
+
+bool NetworkAdapterManager::UpdateNetworkInterface(
+    IP_ADAPTER_ADDRESSES adapter) {
+  local_ip_ = adapter.Address;
+  is_WAN_routing_ = true;
+  OVERRIDE_string(network_guid, adapter.AdapterName);
+  return true;
+}
+
+int32_t NetworkAdapterManager::GetBestInterfaceIfIndex() {
+  return adapter_addresses_.empty() ? -1 : adapter_addresses_.front().IfIndex;
+}
+
+bool NetworkAdapterManager::IsInterfaceWANRouting(sockaddr_in address) {
+  return address.sin_addr.s_addr != 0;
+}
+
+std::optional<sockaddr_in> NetworkAdapterManager::GetInterfaceIPFromIfIndex(
+    int32_t index) const {
+  const auto adapter = GetAdapterFromIfIndex(index);
+  return adapter ? std::optional<sockaddr_in>(adapter->Address) : std::nullopt;
+}
+
+bool NetworkAdapterManager::SelectSavedNetworkAdapter() {
+  if (const auto adapter = GetSelectedAdapter()) {
+    return UpdateNetworkInterface(*adapter);
+  }
+  return false;
+}
+
+void NetworkAdapterManager::AutoSelectNetworkAdapter(int32_t index) {
+  if (!SelectSavedNetworkAdapter()) {
+    if (const auto adapter = GetAdapterFromIfIndex(index)) {
+      UpdateNetworkInterface(*adapter);
+    }
+  }
+}
