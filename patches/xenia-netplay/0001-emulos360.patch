+        vertex.value.normal = packing[0].Read(bits); vertex.value.weights = packing[1].Read(bits);
+        vertex.value.joints = packing[2].Read(bits); vertex.value.color = packing[3].Read(bits);
+        if (!bits.ok() || std::any_of(vertex.value.position.begin(), vertex.value.position.end(), [](float f){return !std::isfinite(f);})) return {};
+        shape.vertices.push_back(vertex);
+      }
+    }
+    return shape;
+  }
+  bool Apply(AvatarModel& model) const {
+    size_t total_index = 0, total_vertex = 0;
+    for (const auto& batch : model.batches) {
+      total_index += batch.indices.size() * 2;
+      total_vertex += batch.vertices.size() * batch.vertex_stride;
+    }
+    if (total_index != index_size || ((total_vertex + 127) & ~size_t(127)) != vertex_size) return false;
+    for (auto index : hidden_triangles) {
+      bool found = false;
+      for (auto& batch : model.batches) {
+        if (index >= batch.indices.size() / 3) { index -= static_cast<uint32_t>(batch.indices.size() / 3); continue; }
+        batch.indices[index * 3 + 1] = batch.indices[index * 3];
+        batch.indices[index * 3 + 2] = batch.indices[index * 3];
+        found = true; break;
+      }
+      if (!found) return false;
+    }
+    for (const auto& vertex : vertices) {
+      size_t offset = vertex.offset;
+      bool found = false;
+      for (auto& batch : model.batches) {
+        const auto size = batch.vertices.size() * batch.vertex_stride;
+        if (offset >= size) { offset -= size; continue; }
+        if (offset % batch.vertex_stride) return false;
+        auto& target = batch.vertices[offset / batch.vertex_stride];
+        const auto uv = target.uv;
+        target = vertex.value; target.uv = uv;
+        found = true; break;
+      }
+      if (!found) return false;
+    }
+    return true;
+  }
+};
+}  // namespace xe::kernel::xam::emulos
+#endif
diff --git a/src/xenia/kernel/xam/emulos_avatar_guest.h b/src/xenia/kernel/xam/emulos_avatar_guest.h
new file mode 100644
index 0000000..1539fab
--- /dev/null
+++ b/src/xenia/kernel/xam/emulos_avatar_guest.h
@@ -0,0 +1,250 @@
+// Emulos360: serialize decoded assets to the public XAvatar (XDK 21256) ABI.
+// Guest addresses are 32-bit and scalars are big-endian, never host pointers.
+#ifndef XENIA_KERNEL_XAM_EMULOS_AVATAR_GUEST_H_
+#define XENIA_KERNEL_XAM_EMULOS_AVATAR_GUEST_H_
+
+#include "xenia/kernel/xam/emulos_avatar_animation.h"
+#include "xenia/kernel/xam/emulos_avatar_scene.h"
+#include <limits>
+
+namespace xe::kernel::xam::emulos {
+
+// The metadata-independent query returns bounded capacities. Building happens
+// in host staging buffers and must fit both capacities before any guest write.
+inline constexpr uint32_t kAvatarGuestCpuCapacity = 1024 * 1024;
+inline constexpr uint32_t kAvatarGuestGpuCapacity = 8 * 1024 * 1024;
+
+class AvatarGuestBuffer {
+ public:
+  AvatarGuestBuffer(uint32_t address, uint32_t capacity)
+      : address_(address), capacity_(capacity) {
+    ok_ = address && uint64_t(address) + capacity <= uint64_t(UINT32_MAX) + 1;
+  }
+  uint32_t Allocate(size_t size, uint32_t alignment = 4) {
+    if (!ok_ || !alignment || (alignment & (alignment - 1))) { ok_ = false; return 0; }
+    const uint64_t aligned = (uint64_t(bytes_.size()) + alignment - 1) & ~uint64_t(alignment - 1);
+    if (aligned > capacity_ || size > capacity_ - aligned) { ok_ = false; return 0; }
+    bytes_.resize(static_cast<size_t>(aligned) + size);
+    return static_cast<uint32_t>(aligned);
+  }
+  void U32(size_t offset, uint32_t value) {
+    if (!Range(offset, 4)) return;
+    AvatarStore32(bytes_, offset, value);
+  }
+  void U16(size_t offset, uint16_t value) {
+    if (!Range(offset, 2)) return;
+    bytes_[offset] = static_cast<uint8_t>(value >> 8);
+    bytes_[offset + 1] = static_cast<uint8_t>(value);
+  }
+  void Float(size_t offset, float value) { U32(offset, std::bit_cast<uint32_t>(value)); }
+  void Copy(size_t offset, AvatarBytes value) {
+    if (Range(offset, value.size())) std::copy(value.begin(), value.end(), bytes_.begin() + offset);
+  }
+  uint32_t Pointer(uint32_t offset) const { return address_ + offset; }
+  bool ok() const { return ok_; }
+  const std::vector<uint8_t>& bytes() const { return bytes_; }
+ private:
+  bool Range(size_t offset, size_t size) {
+    if (!ok_ || offset > bytes_.size() || size > bytes_.size() - offset) { ok_ = false; return false; }
+    return true;
+  }
+  uint32_t address_, capacity_;
+  bool ok_ = true;
+  std::vector<uint8_t> bytes_;
+};
+
+struct AvatarGuestAssets {
+  std::vector<uint8_t> cpu, gpu;
+
+  // ABI4 supports carryables separately; do not label an unimplemented
+  // carryable as successfully loaded. Input meshes and the imported rig are
+  // right-handed; the supported ABI4 guest requests left-handed coordinates.
+  static std::optional<AvatarGuestAssets> Build(
+      const AvatarScene& scene, const AvatarSkeleton& skeleton,
+      uint32_t cpu_address, uint32_t gpu_address, std::string* error = nullptr) {
+    auto fail = [error](const char* reason) -> std::optional<AvatarGuestAssets> {
+      if (error) *error = reason;
+      return {};
+    };
+    if (!cpu_address || (cpu_address & 15) || !gpu_address || (gpu_address & 4095) ||
+        skeleton.joints.empty() || skeleton.joints.size() > 72 || scene.components.size() > 13)
+      return fail("Invalid avatar buffers or skeleton");
+    const uint64_t cpu_end = uint64_t(cpu_address) + kAvatarGuestCpuCapacity;
+    const uint64_t gpu_end = uint64_t(gpu_address) + kAvatarGuestGpuCapacity;
+    if (cpu_end > uint64_t(UINT32_MAX) + 1 || gpu_end > uint64_t(UINT32_MAX) + 1 ||
+        (uint64_t(cpu_address) < gpu_end && uint64_t(gpu_address) < cpu_end))
+      return fail("Overlapping or overflowing avatar buffers");
+    AvatarGuestBuffer cpu(cpu_address, kAvatarGuestCpuCapacity);
+    AvatarGuestBuffer gpu(gpu_address, kAvatarGuestGpuCapacity);
+    cpu.Allocate(20);  // XAVATAR_ASSETS: skeleton, carryable, count, info, models.
+    const auto rig = cpu.Allocate(8);
+    const auto joints = cpu.Allocate(skeleton.joints.size() * 96, 16);
+    cpu.U32(0, cpu.Pointer(rig));
+    cpu.U32(rig, static_cast<uint32_t>(skeleton.joints.size()));
+    cpu.U32(rig + 4, cpu.Pointer(joints));
+    // Reflection S=diag(1,1,-1): positions use S*p and rotations S*R*S.
+    // Apply it to bind and local transforms alike, matching the mesh below.
+    for (size_t i = 0; i < skeleton.joints.size(); ++i) {
+      const auto& joint = skeleton.joints[i];
+      if ((i == 0 && joint.parent != -1) || (i && (joint.parent < 0 || size_t(joint.parent) >= i)))
+        return fail("Invalid avatar joint hierarchy");
+      const auto base = joints + i * 96;
+      uint32_t child = UINT32_MAX, sibling = UINT32_MAX;
+      for (size_t j = i + 1; j < skeleton.joints.size(); ++j) {
+        if (child == UINT32_MAX && skeleton.joints[j].parent == int32_t(i)) child = static_cast<uint32_t>(j);
+        if (sibling == UINT32_MAX && skeleton.joints[j].parent == joint.parent) sibling = static_cast<uint32_t>(j);
+      }
+      cpu.U32(base, static_cast<uint32_t>(joint.parent));
+      cpu.U32(base + 4, child); cpu.U32(base + 8, sibling);
+      for (size_t axis = 0; axis < 3; ++axis) {
+        cpu.Float(base + 16 + axis * 4, (axis == 2 ? -1.f : 1.f) * joint.bind.position[axis]);
+        cpu.Float(base + 48 + axis * 4, (axis == 2 ? -1.f : 1.f) * joint.local.position[axis]);
+        cpu.Float(base + 80 + axis * 4, joint.local.scale[axis]);
+      }
+      // Position becomes the fourth matrix row in Xbox avatar renderers.
+      // The imported rig stores XYZ only; W must be 1 for an affine transform.
+      // Leaving the zero-filled W makes inverse bind matrices singular.
+      cpu.Float(base + 28, 1.0f);
+      cpu.Float(base + 60, 1.0f);
+      for (size_t axis = 0; axis < 4; ++axis) {
+        cpu.Float(base + 32 + axis * 4, (axis < 2 ? -1.f : 1.f) * joint.bind.rotation[axis]);
+        cpu.Float(base + 64 + axis * 4, (axis < 2 ? -1.f : 1.f) * joint.local.rotation[axis]);
+      }
+    }
+    const auto infos = cpu.Allocate(scene.components.size() * 32);
+    const auto models = cpu.Allocate(scene.components.size() * 52);
+    cpu.U32(8, static_cast<uint32_t>(scene.components.size()));
+    cpu.U32(12, cpu.Pointer(infos)); cpu.U32(16, cpu.Pointer(models));
+    for (size_t c = 0; c < scene.components.size(); ++c) {
+      const auto& part = scene.components[c];
+      const auto& model = part.model;
+      if (part.mask & 0x1000) return fail("Carryable avatar assets are not implemented");
+      if (model.batches.size() > 16 || model.textures.size() > 18) return fail("Oversized avatar model");
+      cpu.Copy(infos + c * 32, part.id); cpu.U16(infos + c * 32 + 16, part.mask);
+      const auto m = models + c * 52;
+      const auto batches = cpu.Allocate(model.batches.size() * 512);
+      const auto textures = cpu.Allocate(model.textures.size() * 44);
+      const auto gpu_start = gpu.Allocate(0, 4096);
+      const auto vertex_start = gpu.Allocate(0, 16);
+      std::vector<uint32_t> vertex_offsets;
+      for (const auto& batch : model.batches) {
+        if (!batch.uv_count || batch.uv_count > 6 || batch.vertex_stride != 28 + batch.uv_count * 4 ||
+            batch.vertices.size() > 8192 || batch.indices.size() > 8192 * 3 ||
+            batch.indices.size() % 3 || batch.parameters.size() > 20 || batch.shader > 4)
+          return fail("Invalid avatar batch");
+        const auto vertices = gpu.Allocate(batch.vertices.size() * batch.vertex_stride, 16);
+        vertex_offsets.push_back(vertices);
+        for (size_t v = 0; v < batch.vertices.size(); ++v) {
+          const auto& vertex = batch.vertices[v];
+          const auto p = vertices + v * batch.vertex_stride;
+          for (size_t axis = 0; axis < 3; ++axis) gpu.Float(p + axis * 4, (axis == 2 ? -1.f : 1.f) * vertex.position[axis]);
+          // HEND3N stores signed Z in the high 10 bits. Clamp the
+          // asymmetric -512 endpoint before negating its normalized value.
+          int32_t normal_z = static_cast<int32_t>(vertex.normal >> 22);
+          if (normal_z & 512) normal_z -= 1024;
+          normal_z = -std::max(normal_z, -511);
+          const uint32_t normal = (vertex.normal & 0x3fffffu) |
+              ((static_cast<uint32_t>(normal_z) & 0x3ffu) << 22);
+          gpu.U32(p + 12, normal); gpu.U32(p + 16, vertex.weights);
+          gpu.U32(p + 20, vertex.joints); gpu.U32(p + 24, vertex.color);
+          for (size_t uv = 0; uv < batch.uv_count * 2; ++uv) gpu.U16(p + 28 + uv * 2, vertex.uv[uv]);
+        }
+      }
+      const auto vertex_end = gpu.Allocate(0, 16);
+      const auto index_start = vertex_end;
+      for (size_t b = 0; b < model.batches.size(); ++b) {
+        const auto& batch = model.batches[b];
+        const auto p = batches + b * 512;
+        cpu.U32(p, batch.shader);
+        for (size_t s = 0; s < batch.parameters.size(); ++s) {
+          const auto& param = batch.parameters[s];
+          const auto q = p + 4 + s * 24;
+          cpu.U32(q, param.type); cpu.U32(q + 4, param.usage);
+          if (param.type == 1) {
+            const auto index = param.value[0] & 0xffff;
+            const auto uv = param.value[0] >> 16;
+            if (index >= model.textures.size() || (uv != 0xffff && uv >= batch.uv_count))
+              return fail("Invalid avatar texture binding");
+            cpu.U16(q + 8, static_cast<uint16_t>(index));
+            cpu.U16(q + 10, static_cast<uint16_t>(uv));
+            cpu.U32(q + 12, param.value[1]);
+          } else {
+            for (size_t v = 0; v < 4; ++v) cpu.U32(q + 8 + v * 4, param.value[v]);
+            if (param.type == 3 && param.usage >= 13 && param.usage <= 24) {
+              auto color = param.usage <= 21 ? scene.colors[param.usage - 13] : part.custom_colors[param.usage - 22];
+              if (param.usage >= 22 && !(color >> 24)) {
+                if (part.mask == 2) color = scene.colors[0];
+                if (part.mask == 4) color = scene.colors[1];
+              }
+              if (param.usage <= 21 || (color >> 24)) {
+                for (size_t channel = 0; channel < 3; ++channel)
+                  cpu.Float(q + 8 + channel * 4, float((color >> (16 - channel * 8)) & 255) / 255.f);
+                cpu.Float(q + 20, float(color >> 24) / 255.f);
+              }
+            }
+          }
+        }
+        const auto indices = gpu.Allocate(batch.indices.size() * 2, 16);
+        for (size_t i = 0; i < batch.indices.size(); ++i) {
+          if (batch.indices[i] >= batch.vertices.size()) return fail("Invalid avatar index");
+          // Reflection reverses winding: preserve the title's front faces.
+          const size_t source = i % 3 == 0 ? i : (i % 3 == 1 ? i + 1 : i - 1);
+          gpu.U16(indices + i * 2, batch.indices[source]);
+        }
+        cpu.U32(p + 484, static_cast<uint32_t>(batch.indices.size() / 3));
+        cpu.U32(p + 488, static_cast<uint32_t>(batch.vertices.size()));
+        cpu.U32(p + 492, batch.uv_count); cpu.U32(p + 496, batch.vertex_stride);
+        cpu.U32(p + 500, 2); cpu.U32(p + 504, gpu.Pointer(vertex_offsets[b]));
+        cpu.U32(p + 508, gpu.Pointer(indices));
+      }
+      const auto index_end = gpu.Allocate(0, 16);
+      uint32_t texture_bytes = 0;
+      for (size_t t = 0; t < model.textures.size(); ++t) {
+        const auto& texture = model.textures[t];
+        const auto p = textures + t * 44;
+        const auto format = texture.format & 63;
+        if (format < 18 || format > 20 || !texture.width || texture.width > 1024 ||
+            !texture.height || texture.height > 1024 || !texture.layers || texture.layers > 16)
+          return fail("Unsupported avatar texture");
+        const uint32_t row = ((texture.width + 3) / 4) * (format == 18 ? 8 : 16);
+        const uint32_t pitch = (row + 255) & ~255u;
+        const uint32_t rows = (texture.height + 3) / 4;
+        const uint32_t layer_size = (pitch * ((rows + 31) & ~31u) + 4095) & ~4095u;
+        const uint32_t total = layer_size * texture.layers;
+        if (!texture.empty && texture.pixels.size() != size_t(row) * rows * texture.layers)
+          return fail("Truncated avatar texture");
+        const auto data = gpu.Allocate(total, 4096);
+        // Empty BC1 needs transparent selector 3; zero blocks are opaque black.
+        if (texture.empty && format == 18)
+          for (uint32_t layer = 0; layer < texture.layers; ++layer)
+            for (uint32_t y = 0; y < rows; ++y)
+              for (uint32_t x = 0; x < row; x += 8)
+                gpu.U32(data + layer * layer_size + y * pitch + x + 4, UINT32_MAX);
+        for (uint32_t layer = 0; !texture.empty && layer < texture.layers; ++layer)
+          for (uint32_t y = 0; y < rows; ++y)
+            gpu.Copy(data + layer * layer_size + y * pitch,
+                     AvatarBytes(texture.pixels).subspan((size_t(layer) * rows + y) * row, row));
+        // MAKELINFMT clears D3DFORMAT's tiled bit (0x100). The guest D3D
+        // renderer consumes normal linear BC textures with 256-byte row pitch.
+        cpu.U32(p, texture.format & ~0x100u); cpu.U32(p + 4, texture.width);
+        cpu.U32(p + 8, texture.height); cpu.U32(p + 12, total);
+        cpu.U32(p + 20, layer_size); cpu.U32(p + 28, 1);
+        cpu.U32(p + 32, texture.layers); cpu.U32(p + 36, gpu.Pointer(data));
+        texture_bytes += total;
+      }
+      const auto gpu_end_offset = gpu.Allocate(0, 4096);
+      cpu.U32(m, static_cast<uint32_t>(cpu.bytes().size()) - batches);
+      cpu.U32(m + 4, gpu_end_offset - gpu_start); cpu.U32(m + 8, texture_bytes);
+      cpu.U32(m + 12, vertex_end - vertex_start); cpu.U32(m + 16, index_end - index_start);
+      cpu.U32(m + 20, static_cast<uint32_t>(model.batches.size()));
+      cpu.U32(m + 24, static_cast<uint32_t>(model.textures.size()));
+      cpu.U32(m + 28, cpu.Pointer(batches)); cpu.U32(m + 32, gpu.Pointer(gpu_start));
+      cpu.U32(m + 36, gpu.Pointer(vertex_start)); cpu.U32(m + 40, gpu.Pointer(index_start));
+      cpu.U32(m + 44, cpu.Pointer(batches)); cpu.U32(m + 48, cpu.Pointer(textures));
+      if (!cpu.ok() || !gpu.ok()) return fail("Avatar exceeds guest buffer capacities");
+    }
+    return AvatarGuestAssets{cpu.bytes(), gpu.bytes()};
+  }
+};
+}  // namespace xe::kernel::xam::emulos
+#endif
diff --git a/src/xenia/kernel/xam/emulos_avatar_manifest.h b/src/xenia/kernel/xam/emulos_avatar_manifest.h
new file mode 100644
index 0000000..17b3966
--- /dev/null
+++ b/src/xenia/kernel/xam/emulos_avatar_manifest.h
@@ -0,0 +1,30 @@
+// Emulos360 extension: bounded access to the original opaque avatar manifest.
+// Evidence and limitations: docs/AVATAR_ABI.md in the Emulos360 repository.
+#ifndef XENIA_KERNEL_XAM_EMULOS_AVATAR_MANIFEST_H_
+#define XENIA_KERNEL_XAM_EMULOS_AVATAR_MANIFEST_H_
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace xe::kernel::xam::emulos {
+inline constexpr std::size_t kAvatarManifestSize = 1000;
+inline constexpr std::size_t kAvatarBodyAssetOffset = 0x120;
+
+// Asset IDs are serialized bytes, not host-endian GUID integers.
+inline constexpr std::array<uint8_t, 16> kMaleBodyAsset = {
+    0, 0, 0, 2, 0, 0, 0, 1, 0xC1, 0xC8, 0xF1, 9, 0xA1, 0x9C, 0xB2, 0xE0};
+inline constexpr std::array<uint8_t, 16> kFemaleBodyAsset = {
+    0, 0, 0, 2, 0, 1, 0, 2, 0xC1, 0xC8, 0xF1, 9, 0xA1, 0x9C, 0xB2, 0xE0};
+
+inline uint8_t AvatarBodyType(std::span<const uint8_t> manifest) {
+  if (manifest.size() != kAvatarManifestSize) return 0;
+  const auto body = manifest.subspan(kAvatarBodyAssetOffset, 16);
+  if (std::equal(body.begin(), body.end(), kMaleBodyAsset.begin())) return 1;
+  if (std::equal(body.begin(), body.end(), kFemaleBodyAsset.begin())) return 2;
+  return 0;
+}
+}  // namespace xe::kernel::xam::emulos
+#endif
diff --git a/src/xenia/kernel/xam/emulos_avatar_scene.h b/src/xenia/kernel/xam/emulos_avatar_scene.h
new file mode 100644
index 0000000..42926e2
--- /dev/null
+++ b/src/xenia/kernel/xam/emulos_avatar_scene.h
@@ -0,0 +1,147 @@
+// Emulos360 original-avatar assembly shared by the native UI and guest service.
+#ifndef XENIA_KERNEL_XAM_EMULOS_AVATAR_SCENE_H_
+#define XENIA_KERNEL_XAM_EMULOS_AVATAR_SCENE_H_
+#include "xenia/kernel/xam/emulos_avatar_assets.h"
+#include "xenia/kernel/xam/emulos_avatar_manifest.h"
+#include <map>
+
+namespace xe::kernel::xam::emulos {
+using AvatarManifest = std::array<uint8_t, kAvatarManifestSize>;
+inline bool AvatarIdEmpty(const AvatarAssetId& id) {
+  return std::all_of(id.begin(), id.end(), [](uint8_t b) { return b == 0; });
+}
+inline AvatarAssetId AvatarManifestId(AvatarBytes bytes, size_t offset) {
+  AvatarAssetId id{};
+  if (offset <= bytes.size() && bytes.size() - offset >= id.size())
+    std::copy_n(bytes.begin() + offset, id.size(), id.begin());
+  return id;
+}
+inline void AvatarStore32(std::span<uint8_t> bytes, size_t offset, uint32_t value) {
+  if (offset > bytes.size() || bytes.size() - offset < 4) return;
+  for (size_t i = 0; i < 4; ++i) bytes[offset + i] = static_cast<uint8_t>(value >> (24 - 8 * i));
+}
+inline uint32_t AvatarLoad32(AvatarBytes bytes, size_t offset) {
+  if (offset > bytes.size() || bytes.size() - offset < 4) return 0;
+  AvatarCursor cursor(bytes.subspan(offset, 4)); return cursor.Integer(4, true);
+}
+inline const AvatarAssetRecord* AvatarRecord(const AvatarAssetCatalog& catalog, const AvatarAssetId& id) {
+  for (const auto& record : catalog.records()) if (record.id == id) return &record;
+  return nullptr;
+}
+inline void AvatarSetManifestId(AvatarManifest& manifest, size_t offset, const AvatarAssetId& id) {
+  if (offset <= manifest.size() && id.size() <= manifest.size() - offset)
+    std::copy(id.begin(), id.end(), manifest.begin() + offset);
+}
+inline AvatarManifest DefaultAvatarManifest(const AvatarAssetCatalog& catalog, uint8_t body) {
+  AvatarManifest manifest{};
+  const std::array<uint32_t, 9> colors = {0xffd6ac87,0xff503522,0xffa66a64,0xff62835c,0xff503522,0xff836d88,0xff503522,0xffa8876b,0xff704f3d};
+  for (size_t i = 0; i < colors.size(); ++i) AvatarStore32(manifest, 252 + i * 4, colors[i]);
+  AvatarSetManifestId(manifest, 288, body == 2 ? kFemaleBodyAsset : kMaleBodyAsset);
+  manifest[305] = 2;
+  const std::array<uint32_t, 13> masks = {1,4,8,16,32,0x100000,0x80000,0x200000,0x8000,0x2000,0x4000,0x10000,0x40000};
+  const std::array<size_t, 13> offsets = {320,352,384,416,448,12,28,44,60,92,124,156,188};
+  for (size_t i = 0; i < masks.size(); ++i) {
+    // Facial hair and face paint are optional, unlike eyes/brows/mouth.
+    if (i >= 11) continue;
+    for (const auto& record : catalog.records()) {
+      if (record.component_mask != masks[i] || !(record.body_mask & body)) continue;
+      AvatarSetManifestId(manifest, offsets[i], record.id);
+      if (i < 5) manifest[offsets[i] + 17] = static_cast<uint8_t>(masks[i]);
+      else if (i >= 8) AvatarStore32(manifest, offsets[i] + 16, std::bit_cast<uint32_t>(1.0f));
+      break;
+    }
+  }
+  return manifest;
+}
+
+struct AvatarSceneComponent {
+  AvatarAssetId id{};
+  uint16_t mask = 0;
+  std::array<uint32_t, 3> custom_colors{};
+  AvatarModel model;
+};
+struct AvatarScene {
+  std::vector<AvatarSceneComponent> components;
+  std::array<uint32_t, 9> colors{};
+  uint8_t body = 0;
+  // Decode builds a separate scene so a failure cannot partially replace a
+  // visible avatar or leave the guest's buffers half written.
+  template <typename Decompress>
+  static std::optional<AvatarScene> Decode(const AvatarAssetCatalog& catalog, AvatarBytes manifest, uint32_t mask, Decompress decompress, std::string* error = nullptr) {
+    auto fail = [error](const std::string& reason) -> std::optional<AvatarScene> { if (error) *error = reason; return {}; };
+    if (manifest.size() != kAvatarManifestSize || !AvatarBodyType(manifest) || AvatarLoad32(manifest, 0) != 0 || (mask & ~0x1fffu)) return fail("Invalid avatar manifest");
+    AvatarScene scene; scene.body = AvatarBodyType(manifest);
+    for (size_t i = 0; i < scene.colors.size(); ++i) scene.colors[i] = AvatarLoad32(manifest, 252 + 4 * i);
+    std::vector<AvatarAssetId> shapes;
+    bool has_hat=false;
+    for(size_t i=2;i<15;++i){const auto p=288+i*32;if(((manifest[p+16]<<8)|manifest[p+17])&64)has_hat=true;}
+    for (size_t i = 0; i < 3; ++i) {
+      const auto id = AvatarManifestId(manifest, 12 + i * 16);
+      if (!AvatarIdEmpty(id)) shapes.push_back(id);
+    }
+    for (size_t i = 0; i < 15; ++i) {
+      const auto offset = 288 + i * 32;
+      auto id = AvatarManifestId(manifest, offset);
+      if (AvatarIdEmpty(id)) continue;
+      const auto* record = AvatarRecord(catalog, id);
+      if (!record || !(record->body_mask & scene.body)) return fail("Missing or incompatible avatar component");
+      if(has_hat&&record->component_mask==4)for(const auto& dependency:record->dependencies){
+        const auto* alternate=AvatarRecord(catalog,dependency);
+        if(alternate&&alternate->component_mask==4&&(alternate->body_mask&scene.body)){id=dependency;record=alternate;break;}
+      }
+      const auto component = uint16_t((manifest[offset + 16] << 8) | manifest[offset + 17]);
+      if (!(component & mask)) continue;
+      const auto strb = AvatarStructuredAsset::Parse(catalog.Find(id));
+      if (!strb) return fail("Invalid component STRB");
+      const auto decoded = DecodeAvatarModelFrames(strb->Find(3), decompress);
+      if (!decoded) return fail("Invalid compressed model");
+      auto model = AvatarModel::Parse(*decoded);
+      if (!model) return fail("Invalid model data");
+      AvatarSceneComponent part;
+      part.id = id; part.mask = component; part.model = std::move(*model);
+      for (size_t color = 0; color < 3; ++color) part.custom_colors[color] = AvatarLoad32(manifest, offset + 20 + color * 4);
+      scene.components.push_back(std::move(part));
+      for (const auto& dependency : record->dependencies) {
+        const auto* entry = AvatarRecord(catalog, dependency);
+        // Some dependencies are alternative hair models for hats, not shape
+        // overrides. Only the hiding-template class modifies the body here.
+        if (entry && entry->component_mask == 0x01000000) shapes.push_back(dependency);
+      }
+    }
+    for (const auto& id : shapes) {
+      const auto asset = AvatarStructuredAsset::Parse(catalog.Find(id));
+      if (!asset) return fail("Missing shape resource");
+      const auto shape = AvatarShapeOverride::Parse(asset->Find(4));
+      if (!shape) return fail("Invalid shape override: " + std::to_string((id[4] << 8) | id[5]));
+      for (auto& component : scene.components)
+        if (component.id == shape->target && !shape->Apply(component.model)) return fail("Shape override does not match target model");
+    }
+    // The six manifest texture slots correspond to mouth, eyes, eyebrows,
+    // facial hair, eye shadow and skin features. Replace the shader's named
+    // texture without changing unrelated layers or UV channels.
+    constexpr std::array<std::array<uint32_t, 2>, 6> usages = {{{12,0},{9,10},{7,8},{6,0},{11,0},{5,0}}};
+    for (size_t slot = 0; slot < usages.size(); ++slot) {
+      const auto id = AvatarManifestId(manifest, 60 + slot * 32);
+      if (AvatarIdEmpty(id)) continue;
+      const auto asset = AvatarStructuredAsset::Parse(catalog.Find(id));
+      if (!asset) return fail("Missing facial texture resource");
+      const auto decoded = DecodeAvatarModelFrames(asset->Find(2), decompress);
+      if (!decoded) return fail("Invalid compressed facial texture");
+      AvatarCursor cursor(*decoded);
+      const auto texture = AvatarModelTexture::Parse(cursor);
+      if (!texture) return fail("Invalid facial texture resource");
+      for (auto& component : scene.components) {
+        if (!(component.mask & 1)) continue;
+        for (const auto& batch : component.model.batches) for (const auto& parameter : batch.parameters) {
+          if (parameter.type != 1 || (parameter.usage != usages[slot][0] && (!usages[slot][1] || parameter.usage != usages[slot][1]))) continue;
+          const auto index = parameter.value[0] & 0xffff;
+          if (index >= component.model.textures.size()) return fail("Invalid facial texture index");
+          component.model.textures[index] = *texture;
+        }
+      }
+    }
+    return scene;
+  }
+};
+}  // namespace xe::kernel::xam::emulos
+#endif
